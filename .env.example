# Copy to .env — src/config.ts loads it automatically (shell-exported
# variables take precedence). Never commit a real .env: the agent key lives
# only on the machine that runs the bot.
AGENT_PRIVATE_KEY=0x...
CELO_RPC_URL=https://forno.celo.org
# Payee: the real person this payout goes to (Celo / MiniPay wallet).
# Leave empty until George confirms the payee — the payout step refuses
# to run without it, and this repo must never invent one.
PAYEE_ADDRESS=
# Payout parameters (optional overrides; defaults shown)
PAYOUT_SIZE_USDT=10
MIN_EDGE_USD=0.05
MAX_TRADE_USD=500
RFQ_TIMEOUT_MS=75000
# Quoting parameters (optional overrides; defaults shown)
BASE_SPREAD_BPS=3
VOL_MULTIPLIER=1.5
MAX_SKEW_BPS=25
TARGET_USDT_SHARE=0.5
BAND_WIDTH=0.2
MAX_QUOTE_USDT=500
MAX_SHARE_PER_QUOTE=0.25
MAX_SPREAD_BPS=150
REF_DIVERGENCE_HALT_BPS=1000
# LIVE=0 (default) is dry-run: scan, preview, log, send nothing.
# LIVE=1 executes on mainnet. Only set it for a real payout run.
LIVE=0
